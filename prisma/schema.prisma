generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Kategori catatan, biasanya satu mata kuliah.
model TulisCategory {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  notes     Note[]

  @@index([name])
}

// Satu catatan. Isinya teks bebas; tautan referensi dan berkas
// menyusul sebagai relasi di migrasi berikutnya.
model Note {
  id         String    @id @default(cuid())
  title      String
  content    String
  categoryId String?
  category   TulisCategory? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  attachments Attachment[]
  links       TulisLink[]

  @@index([categoryId, updatedAt])
}

// Berkas pendukung yang diunggah untuk satu catatan. Hanya PDF,
// dokumen Word, dan presentasi yang diterima; jalurnya menunjuk
// objek di bucket Storage `tulisqu-files`.
model Attachment {
  id          String   @id @default(cuid())
  noteId      String
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime @default(now())

  @@index([noteId, createdAt])
}

// Tautan referensi yang disimpan di satu catatan. Judul halaman
// diambil sekali saat tautan disimpan, supaya daftar tetap bisa
// dibaca walau halaman asalnya sedang tidak bisa dibuka.
model TulisLink {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  createdAt DateTime @default(now())

  @@index([noteId, createdAt])
}

// Satu tugas harian. dueDate menyimpan tanggal tugas (jam diabaikan
// di lapisan tampilan); done menandai tugas sudah dikerjakan.
model Task {
  id        String   @id @default(cuid())
  title     String
  dueDate   DateTime
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([dueDate, done])
}
