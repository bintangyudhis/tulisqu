# Contoh variabel lingkungan. Salin ke .env untuk pengembangan lokal.
# JANGAN pernah mengisi berkas ini dengan kredensial asli.
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/database"
# Supabase Storage untuk berkas catatan (bucket `tulisqu-files`).
# Dipakai mulai fitur unggah berkas; kosongkan bila belum dipasang.
# Kunci service role HANYA untuk sisi server (route API) — jangan pernah
# memakai awalan NEXT_PUBLIC_* untuk kunci ini.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
